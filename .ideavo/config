{
  "systemSetup": [
    {
      "name": "Install pnpm globally",
      "command": "curl -fsSL https://pnpm.io/install.sh | sh -s -- --pnpm"
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install dependencies",
      "command": "npx --yes pnpm@10 install"
    }
  ],
  "codeChecks": [
    {
      "name": "Type check",
      "command": "pnpm run typecheck"
    }
  ],
  "buildSteps": [
    {
      "name": "Build all packages",
      "command": "pnpm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run development server",
      "command": "pnpm --filter @workspace/api-server run dev --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [
    {
      "name": "Deploy to Railway",
      "command": "echo "Deploying to Railway..." && git push"
    }
  ],
  "cleanupFiles": [
    "./node_modules",
    "./artifacts/tnc-web/node_modules",
    "./artifacts/api-server/node_modules",
    "./lib/api-zod/node_modules",
    "./lib/db/node_modules",
    "./lib/api-spec/node_modules",
    "./lib/api-client-react/node_modules",
    "./scripts/node_modules"
  ],
  "packageManager": "pnpm",
  "envPaths": [
    { "name": "default", "path": ".env" },
    { "name": "artifacts/tnc-web", "path": "./artifacts/tnc-web/.env" },
    { "name": "artifacts/api-server", "path": "./artifacts/api-server/.env" }
  ]
}